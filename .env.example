# Zkopíruj na .env a vyplň. .env je v .gitignore (tajné věci nepatří do gitu).
#
# DŮLEŽITÉ: komentář dávej VŽDY na vlastní řádek (jako tady), NE za hodnotu.
# Docker Compose env_file ve starších verzích inline komentář ' # ...' neodstřihne
# a hodnota se rozbije (např. REGION_IDS by bylo "8   # ..." -> pád na int()).

# --- Telegram (povinné pro reálné odesílání; bez nich se vynutí dry_run) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- chování notifikací ---
# DRY_RUN: true = zprávy se jen logují, neodesílají
DRY_RUN=false
# HEARTBEAT: denní "✅ Běžím…" zpráva (max 1x za den, i ve smyčce)
HEARTBEAT=true
# STARTUP_NOTICE: po startu (Build/restart kontejneru) poslat "✅ nasazeno a běží" + počet v DB
STARTUP_NOTICE=true
# SCORE_THRESHOLD: posílej jen inzeráty se skóre >= prahu.
# 55 = rozumný start (den 1 má max ~65, signály pokles/doba teprve naskáčou); časem zvyš.
SCORE_THRESHOLD=55

# --- plánování ---
# INTERVAL_HOURS: 0 = jednorázový běh (cron / Synology Task Scheduler).
#                 >0 = kontejner běží pořád a scrapuje sám každých N h (Container Manager Projekt).
INTERVAL_HOURS=3

# --- zdroje a geografie ---
# ACTIVE_SOURCES: čárkou oddělené zdroje. K dispozici: sreality, bezrealitky, idnes.
ACTIVE_SOURCES=sreality,bezrealitky,idnes
# REGION_IDS: Sreality region. 8 = Olomoucký kraj (víc krajů: "8,12"). Ověřeno z filter_page.
REGION_IDS=8
# BEZREALITKY_REGION_IDS: Bezrealitky regionId. 495 = Olomoucký kraj (ověřeno přes czechRegions).
BEZREALITKY_REGION_IDS=495
# IDNES_REGION_SLUGS: iDnes slug kraje v URL. Pozn.: okresy umí scraper zatím jen pro Olomoucký kraj.
IDNES_REGION_SLUGS=olomoucky-kraj

# --- Sreality scraper ---
# CATEGORY_MAIN_CB: 1 = Byty, 2 = Domy. Oboje najednou: "1,2"
CATEGORY_MAIN_CB=1,2

# --- srovnávací analýza (comps) ---
# POZOR: portály dávají jen NABÍDKOVÉ ceny, ne realizované. Comps = "za kolik se nabízí".
# RENOVATION_COST_PER_M2: hrubý odhad ceny celkové rekonstrukce za m² užitné plochy
RENOVATION_COST_PER_M2=20000
# SALE_FACTOR: nabídková -> očekávaná realizovaná cena (0.92 = počítá se ~8% smlouváním)
SALE_FACTOR=0.92
# COMPS_RADIUS_KM: okruh "blízkého okolí". U domů rozhoduje lokalita víc než plocha.
COMPS_RADIUS_KM=15
# CATEGORY_TYPE_CB: 1 = Prodej
CATEGORY_TYPE_CB=1
PAGE_SIZE=100
# MAX_LISTINGS: prázdné = vše; číslo = strop inzerátů/region (pro testy)
MAX_LISTINGS=
# DETAIL_LIMIT: prázdné = bez stropu; číslo = strop detailů/běh
DETAIL_LIMIT=
# RATE_LIMIT_S: pauza mezi requesty (>= 1,5 s)
RATE_LIMIT_S=1.6
USER_AGENT=realitni-scraper/0.1 (osobni nekomercni projekt)

# --- úložiště ---
# Lokálně klidně realitky.db; v Dockeru data/realitky.db (mountnutý volume -> přežije restart).
# Pozn.: v docker-compose.yml je DB_PATH=data/realitky.db nastaveno natvrdo (přebije tento řádek).
DB_PATH=realitky.db

# ============================================================================
# INVESTIČNÍ REŽIM (investment_main.py) — samostatný proces, samostatný chat,
# samostatná DB. Hlavní monitoring výše (main.py) tímhle blokem není ovlivněn.
# Sdílí jen TELEGRAM_BOT_TOKEN (stejný bot, jiný chat_id).
#
# 4 NEZÁVISLÉ zdroje (investment/sources/*_source.py): Sreality (JSON API),
# Realingo, Bazoš, reality-sumperk.cz (HTML, viz robots.txt poznámky níže).
# Pád/redesign JEDNOHO zdroje nezastaví ostatní.
# ============================================================================

# INVESTMENT_ENABLED: pojistka — investment_main.py bez tohohle jen skončí (nic neudělá).
INVESTMENT_ENABLED=false
# TELEGRAM_INVESTMENT_CHAT_ID: SAMOSTATNÝ chat/kanál, ať se investiční tipy nemíchají
# s hlavními alerty. Zjistíš stejně jako TELEGRAM_CHAT_ID výše.
TELEGRAM_INVESTMENT_CHAT_ID=
# INVESTMENT_DRY_RUN: true = zprávy se jen logují (bez tokenu/chat_id se vynutí i tak)
INVESTMENT_DRY_RUN=false

# --- zdroje a NEZÁVISLÉ plánování (každý zdroj má svůj vlastní interval) ---
# INVESTMENT_ACTIVE_SOURCES: čárkou oddělené: sreality, realingo, bazos, reality_sumperk.
INVESTMENT_ACTIVE_SOURCES=sreality,realingo,bazos,reality_sumperk
# Dobré nabídky mizí rychle -> Sreality (rychlé JSON API) výchozích 30 min.
INVESTMENT_SREALITY_POLL_INTERVAL_MINUTES=30
# HTML zdroje jedou šetrněji (víc requestů na stránku, robots.txt rate-limit) -> 60 min.
INVESTMENT_REALINGO_POLL_INTERVAL_MINUTES=60
INVESTMENT_BAZOS_POLL_INTERVAL_MINUTES=60
INVESTMENT_SUMPERK_POLL_INTERVAL_MINUTES=60
# Kolik stránek smí každý HTML zdroj max. projít za jeden běh.
# Realingo řadí od nejlevnějšího -> stačí pár stran (early-stop, jakmile strana
# celá přesáhne PRICE_MAX). Bazoš NEJDE URL vyfiltrovat na Šumperk ani seřadit
# (viz robots.txt poznámka níže) -> potřebuje víc stránek na šanci narazit na
# Šumperk mezi celostátní nabídkou (nemusí najít vše za jeden běh — dohání se
# dalšími běhy, defaultně po hodině).
INVESTMENT_REALINGO_MAX_PAGES=5
INVESTMENT_BAZOS_MAX_PAGES=25
INVESTMENT_SUMPERK_MAX_PAGES=5
# Po kolika selháních V KUSE (u jednoho zdroje) přijde JEDNO Telegram varování
# (ne za každý běh — ať bot nezahltí, když třeba Bazoš na pár hodin spadne).
INVESTMENT_SOURCE_FAILURE_ALERT_THRESHOLD=3

# --- lokalita: obec Šumperk, s přepínačem na celý okres ---
# INVESTMENT_DISTRICT_ID: Sreality locality_district_id (ověřeno živě: 44 = okres Šumperk).
INVESTMENT_DISTRICT_ID=44
# INVESTMENT_CITY_FILTER: obec, na kterou se filtruje, když INVESTMENT_INCLUDE_DISTRICT=false.
INVESTMENT_CITY_FILTER=Šumperk
# INVESTMENT_INCLUDE_DISTRICT: true = celý okres Šumperk (víc nabídek, širší okolí),
# false = jen samotná obec Šumperk. Bazoš okres pozná jen podle statického seznamu
# obcí (investment/filters.py:OKRES_SUMPERK_TOWNS, ověřeno živě z Wikipedie).
INVESTMENT_INCLUDE_DISTRICT=false

# --- velikost / dispozice / cena (revidováno pro levnější konec trhu) ---
INVESTMENT_SIZE_MIN=40
INVESTMENT_SIZE_MAX=70
INVESTMENT_LAYOUTS=2+1,2+kk,3+1
INVESTMENT_PRICE_MAX=2800000
# INVESTMENT_PRICE_TARGET_MAX: pod touhle hranicí je to skutečný nákupní rozpočet ->
# bonus ve skóre (15 %, viz váhy u INVESTMENT_SCORE_THRESHOLD níže).
INVESTMENT_PRICE_TARGET_MAX=2000000

# --- rolling průměr cena/m² (počítá se z reálně scrapovaných dat napříč VŠEMI zdroji) ---
INVESTMENT_AVG_WINDOW_N=30
# INVESTMENT_AVG_MIN_SAMPLE: pod tímto vzorkem se cenový signál skóre přeskočí (cold-start).
INVESTMENT_AVG_MIN_SAMPLE=5

# --- cross-source deduplikace (stejný byt na víc portálech -> nechá se jen nejlevnější) ---
INVESTMENT_DEDUP_PRICE_PCT=0.02
INVESTMENT_DEDUP_SIZE_M2=2.0

# --- klíčová slova stavu (příležitost, NE diskvalifikace -> jen nastaví renovation_flag) ---
INVESTMENT_CONDITION_KEYWORDS=před rekonstrukcí,původní stav,k rekonstrukci,nutná rekonstrukce

# --- odhad výnosu (vše laditelné) ---
INVESTMENT_RENT_PER_M2=200
INVESTMENT_FOND_OPRAV=2000
INVESTMENT_INSURANCE=300
INVESTMENT_TAX=300
INVESTMENT_MAINTENANCE_RESERVE=1000
INVESTMENT_LTV=0.90
INVESTMENT_MORTGAGE_YEARS=30
INVESTMENT_INTEREST_RATE_PCT=4.6

# --- skóre: JEN nízký práh, NE tvrdý filtr (raději víc hraničních tipů než žádné) ---
# Váhy (pevné, ne konfigurovatelné): cena/m² vs průměr 40 % · hrubý výnos 25 % ·
# renovation_flag 20 % · pod PRICE_TARGET_MAX 15 %.
INVESTMENT_SCORE_THRESHOLD=40

# --- úložiště investičního režimu (odděleně od DB_PATH výše) ---
INVESTMENT_DB_PATH=investment.db
