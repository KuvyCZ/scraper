# Zkopíruj na .env a vyplň. .env je v .gitignore (tajné věci nepatří do gitu).
# Komentáře dávej na VLASTNÍ řádek, ne za hodnotu (starší Docker Compose je neodstřihne).
# Všechno kromě Telegramu má rozumný výchozí stav — stačí vyplnit první dva řádky.

# --- Telegram (bez nich se jen loguje, nic se neposílá) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# DRY_RUN: true = zprávy se jen logují
DRY_RUN=false

# --- co sledujeme ---
# Obce jsou napevno ve flip/towns.py: větší obce Olomouckého kraje (zhruba od 2 000 obyvatel).
# BAZOS_PSC: Bazoš se filtruje podle PSČ, ne podle názvu obce. Formát PSČ=obec, odděleno čárkou.
# Prázdné = PSČ ze seznamu obcí ve flip/towns.py (doporučeno). Když ho vyplníš, nahradí výchozí.
# BAZOS_PSC=787 01=Šumperk, 788 03=Nový Malín
# PRICE_MAX: rozpočet v Kč. Dražší přijde jen tehdy, když je za m² aspoň o
# OVER_BUDGET_DISCOUNT_PCT % levnější než typická cena v obci (0 = nad rozpočet nikdy).
PRICE_MAX=5000000
OVER_BUDGET_DISCOUNT_PCT=20
INCLUDE_FLATS=true
INCLUDE_HOUSES=true
# AREA_MIN / AREA_MAX v m² (0 = bez omezení)
AREA_MIN=0
AREA_MAX=0

# --- ekonomika flipu (odhad marže ve zprávě) ---
# Kč za m² užitné plochy, celková rekonstrukce
RENO_COST_FLAT_M2=25000
RENO_COST_HOUSE_M2=30000
# nabídková cena po rekonstrukci -> realistická prodejní (0.92 = počítá se ~8 % smlouvání)
SALE_FACTOR=0.92
# vedlejší náklady flipu jako podíl z (cena + rekonstrukce): makléř, poplatky, úroky, energie
HOLDING_COST_PCT=0.05

# --- notifikace ---
# od tohoto skóre 🔥
HOT_SCORE=65
# nebo když odhad marže >= tolik %
HOT_MARGIN_PCT=20
# zlevnění už oznámené nemovitosti o >= tolik % -> 📉 zpráva
PRICE_DROP_ALERT_PCT=3
# první běh: místo záplavy jedno shrnutí s top N
BASELINE_TOP_N=10
# tabulka cen po obcích na Telegram + data/town_prices.csv: každých N dní (0 = vypnuto),
# počítaná z inzerátů viděných za posledních N dní
TOWN_REPORT_DAYS=7
TOWN_REPORT_WINDOW_DAYS=30

# --- zdroje a plánování ---
# ACTIVE_SOURCES: sreality, realingo, bazos, reality_sumperk
ACTIVE_SOURCES=sreality,realingo,bazos,reality_sumperk
# jak často (minuty) se každý zdroj kontroluje; 0 = jen jednou a konec
SREALITY_INTERVAL_MINUTES=30
REALINGO_INTERVAL_MINUTES=60
BAZOS_INTERVAL_MINUTES=60
REALITY_SUMPERK_INTERVAL_MINUTES=60
# max. stránek na běh (HTML weby, šetrně)
REALINGO_MAX_PAGES=20
BAZOS_MAX_PAGES=25
REALITY_SUMPERK_MAX_PAGES=5
# po kolika selháních zdroje v kuse přijde (jedno) varování
SOURCE_FAILURE_ALERT_THRESHOLD=3

# --- trh ---
# z jak starých inzerátů se počítá medián / cena po rekonstrukci
MARKET_WINDOW_DAYS=90
# minimum srovnatelných; pod tím se cena nesrovnává (nehádá se)
MIN_COMPS=5
# Sreality kraj (8 = Olomoucký) a okresy pro Realingo
SREALITY_REGION_ID=8
REALINGO_DISTRICTS=Jeseník,Olomouc,Prostějov,Přerov,Šumperk

# --- úložiště a logy ---
# v Dockeru data/flip.db (mountnutý volume, přežije restart)
DB_PATH=flip.db
# LOG_FILE=flip.log
